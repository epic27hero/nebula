            "yaml_body": "apiVersion: argoproj.io/v1alpha1\nkind: Application\nmetadata:\n  name: fastapi-prod\n  namespace: argocd\nspec:\n  project: default\n\n  source:\n    repoURL: http://192.168.0.190/your-group/fastapi-gitops.git\n    targetRevision: master\n    path: k8s/production\n\n  destination:\n    server: https://kubernetes.default.svc\n    namespace: production\n\n  syncPolicy:\n    automated:\n      prune: true\n      selfHeal: true\n",
